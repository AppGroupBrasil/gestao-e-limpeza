NODE_ENV=production
PORT=3001
# Número de proxies confiáveis à frente do app (nginx=1, nginx+cloudflare=2)
TRUST_PROXY=1
LOG_LEVEL=info
DATABASE_URL=
DB_HOST=SEU_HOST_SUPABASE
DB_PORT=5432
DB_NAME=postgres
DB_USER=SEU_USUARIO_SUPABASE
DB_PASSWORD=SUA_SENHA_SUPABASE
DB_SSL=true
DB_POOL_MAX=80
# Em produção JWT_SECRET DEVE ter ≥32 chars. Gere com: openssl rand -hex 32
JWT_SECRET=gere_um_valor_unico_com_openssl_rand_hex_32
# Domínios separados por vírgula que podem fazer CORS
CORS_ORIGIN=https://app.exemplo.com,https://www.exemplo.com
FRONTEND_URL=https://app.exemplo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password-google
SMTP_FROM_EMAIL=seu-email@gmail.com
SMTP_FROM_NAME=Gestão e Limpeza
# Validação do certificado do Postgres (padrão: aceita qualquer cert)
DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=  # conteúdo PEM do CA do provedor (habilita rejectUnauthorized)
# Segredo compartilhado do push de provisionamento da central (obrigatório p/ SSO Fase 2)
PROVISIONING_SECRET=
# SSO central
SSO_AUDIENCE=gestao-limpeza
SSO_JWKS_URL=https://auth.appgroupbrasil.com.br/api/v1/sso/jwks.json
# Seed do usuário master (npm run db:seed) — sem default, obrigatório
SEED_MASTER_EMAIL=
SEED_MASTER_PASSWORD=
SEED_MASTER_NOME=Master Admin
